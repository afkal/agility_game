# Copy to /etc/agility-camp.env (readable by root and the agility user only).
PORT=8787
HOST=127.0.0.1
DB_PATH=/var/lib/agility-camp/agility-camp.db
STATIC_ROOT=/opt/agility-camp/app/dist
# Secret for test mode: open the game with ?testi=<this value> to play every
# released door early without saving results. Leave empty to turn it off.
TEST_KEY=
